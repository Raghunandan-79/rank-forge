{
  "openapi": "3.0.3",
  "info": {
    "title": "RankForge API Docs",
    "description": "Backend API documentation for RankForge, a competitive programming and coding arena platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API Version 1 Base"
    }
  ],
  "components": {
    "securitySchemes": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_id",
        "description": "Session cookie required for authenticated endpoints."
      },
      "CsrfAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "CSRF Token header required for state-changing requests (POST, PUT, DELETE, PATCH)."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["USER", "PROBLEM_SETTER", "ADMIN"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
          "timeLimit": { "type": "number", "description": "Time limit in seconds" },
          "memoryLimit": { "type": "number", "description": "Memory limit in MB" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Contest": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Submission": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "language": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "COMPILING", "RUNNING", "ACCEPTED", "WRONG_ANSWER", "TIME_LIMIT_EXCEEDED", "MEMORY_LIMIT_EXCEEDED", "RUNTIME_ERROR", "COMPILATION_ERROR", "INTERNAL_ERROR"] },
          "executionTime": { "type": "number" },
          "memoryUsed": { "type": "number" },
          "error": { "type": "string", "nullable": true },
          "points": { "type": "integer" },
          "userId": { "type": "string", "format": "uuid" },
          "problemId": { "type": "string", "format": "uuid" },
          "contestId": { "type": "string", "format": "uuid", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TestCase": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "isPublic": { "type": "boolean" },
          "points": { "type": "integer" },
          "problemId": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 3 },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User signed up successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid format or username/email already taken" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in to the application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string", "example": "session_id=...; HttpOnly; SameSite=Lax; Path=/" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" },
                    "csrfToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid format" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get currently logged in user info",
        "security": [{ "CookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user profile info and active CSRF Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "csrfToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log out from the application",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "responses": {
          "200": {
            "description": "Successfully logged out",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string", "example": "session_id=; Max-Age=0; Path=/" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized or CSRF missing" }
        }
      }
    },
    "/problems": {
      "get": {
        "tags": ["Problems"],
        "summary": "List all problems",
        "responses": {
          "200": {
            "description": "List of problems",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Problem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Problems"],
        "summary": "Create a new problem",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "difficulty", "timeLimit", "memoryLimit"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
                  "timeLimit": { "type": "number", "default": 1.0 },
                  "memoryLimit": { "type": "number", "default": 256.0 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Problem created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Problem" }
              }
            }
          },
          "400": { "description": "Invalid format" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - requires Admin or Problem Setter role" }
        }
      }
    },
    "/problems/{slug}": {
      "get": {
        "tags": ["Problems"],
        "summary": "Get a problem by slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Problem details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Problem" }
              }
            }
          },
          "404": { "description": "Problem not found" }
        }
      },
      "delete": {
        "tags": ["Problems"],
        "summary": "Delete a problem by slug",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Problem successfully deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - requires Admin or Problem Setter role" },
          "404": { "description": "Problem not found" }
        }
      }
    },
    "/problems/{slug}/submissions": {
      "get": {
        "tags": ["Problems"],
        "summary": "Get submissions for a problem",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of submissions for the problem",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Submission" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Problems"],
        "summary": "Submit code for a problem",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "language"],
                "properties": {
                  "code": { "type": "string" },
                  "language": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Submission received and queued for evaluation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Submission" }
              }
            }
          },
          "400": { "description": "Invalid format" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/problems/{slug}/admin-test-cases": {
      "get": {
        "tags": ["Problems"],
        "summary": "Get all test cases for a problem (Admin/Setter only)",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of all test cases (including hidden)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TestCase" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/problems/{slug}/test-cases": {
      "post": {
        "tags": ["Problems"],
        "summary": "Add a new test case to a problem",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input", "output", "isPublic", "points"],
                "properties": {
                  "input": { "type": "string" },
                  "output": { "type": "string" },
                  "isPublic": { "type": "boolean" },
                  "points": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Test case created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TestCase" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/problems/{slug}/test-cases/{id}": {
      "delete": {
        "tags": ["Problems"],
        "summary": "Delete a test case by id",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Test case successfully deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/contests": {
      "get": {
        "tags": ["Contests"],
        "summary": "List all contests",
        "responses": {
          "200": {
            "description": "List of contests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Contest" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Contests"],
        "summary": "Create a new contest (Admin only)",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "startTime", "endTime"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "startTime": { "type": "string", "format": "date-time" },
                  "endTime": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contest created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contest" }
              }
            }
          },
          "400": { "description": "Invalid format" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/contests/{slug}": {
      "get": {
        "tags": ["Contests"],
        "summary": "Get contest details by slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Contest details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contest" }
              }
            }
          },
          "404": { "description": "Contest not found" }
        }
      },
      "delete": {
        "tags": ["Contests"],
        "summary": "Delete a contest by slug (Admin only)",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Contest deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Contest not found" }
        }
      }
    },
    "/contests/{slug}/problems": {
      "post": {
        "tags": ["Contests"],
        "summary": "Add a problem to a contest (Admin/Setter only)",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["problemId", "points"],
                "properties": {
                  "problemId": { "type": "string", "format": "uuid" },
                  "points": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Problem added to contest successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/contests/{slug}/register": {
      "post": {
        "tags": ["Contests"],
        "summary": "Register current user for a contest",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Successfully registered for contest" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/contests/{slug}/leaderboard": {
      "get": {
        "tags": ["Contests"],
        "summary": "Get contest leaderboard",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Contest leaderboard standings list"
          }
        }
      }
    },
    "/contests/{slug}/standings": {
      "get": {
        "tags": ["Contests"],
        "summary": "Get contest standings",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Contest standings details"
          }
        }
      }
    },
    "/contests/{slug}/standings/stream": {
      "get": {
        "tags": ["Contests"],
        "summary": "SSE Stream for real-time contest standings updates",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Server Sent Events connection stream"
          }
        }
      }
    },
    "/contests/{contestSlug}/problems/{problemSlug}/submissions": {
      "post": {
        "tags": ["Contests"],
        "summary": "Submit code for a problem inside a specific contest",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "contestSlug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "problemSlug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "language"],
                "properties": {
                  "code": { "type": "string" },
                  "language": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Contest submission received and queued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Submission" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/submissions/me": {
      "get": {
        "tags": ["Submissions"],
        "summary": "Get all submissions of the logged in user",
        "security": [{ "CookieAuth": [] }],
        "responses": {
          "200": {
            "description": "List of user's submissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Submission" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/submissions/{id}": {
      "get": {
        "tags": ["Submissions"],
        "summary": "Get submission details by ID",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Submission details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Submission" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Submission not found" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get list of all users (Admin only)",
        "security": [{ "CookieAuth": [] }],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/users/{id}/role": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update user's role (Admin only)",
        "security": [{ "CookieAuth": [] }, { "CsrfAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "type": "string", "enum": ["USER", "PROBLEM_SETTER", "ADMIN"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User role updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
